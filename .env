# Environment Configuration for Crop Prediction System

# Flask Configuration
FLASK_APP=api_server.py
FLASK_ENV=production
FLASK_DEBUG=0

# Model Configuration
MODEL_PATH=crop_model.pkl

# Server Configuration
HOST=0.0.0.0
PORT=5000
WORKERS=4

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/crop_prediction.log

# CORS Configuration
CORS_ORIGINS=*

# OpenWeather API key for automated 3-month forecast lookup
OPENWEATHER_API_KEY=

# Optional Google Earth Engine credentials for NDVI auto-fill
# Set either:
# 1. EARTH_ENGINE_PROJECT + GOOGLE_APPLICATION_CREDENTIALS
# 2. GEE_PROJECT + GEE_SERVICE_ACCOUNT + GEE_CREDENTIALS_FILE
EARTH_ENGINE_PROJECT=
GEE_PROJECT=
GEE_SERVICE_ACCOUNT=
GEE_CREDENTIALS_FILE=
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\gee-service-account.json

# Optional: External API Keys (if needed for other data sources)
# WEATHER_API_KEY=your_weather_api_key_here
# SOIL_API_KEY=your_soil_api_key_here

# Database Configuration (if using database in future)
# DATABASE_URL=sqlite:///crop_prediction.db

# Security
SECRET_KEY=your-secret-key-change-in-production
